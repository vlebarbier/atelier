{
  "name": "@atelier/web",
  "version": "0.1.0",
  "private": true,
  "description": "Web Atelier, React + TypeScript + Vite, vue grille de brouillons (DA Linear/cyan)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "VITE_API_PORT=4320 playwright test",
    "test:e2e:update": "VITE_API_PORT=4320 playwright test --update-snapshots"
  },
  "dependencies": {
    "@atelier/tokens": "*",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
