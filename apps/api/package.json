{
  "name": "@atelier/api",
  "version": "0.1.0",
  "private": true,
  "description": "API Atelier, Hono + SQLite (better-sqlite3) + Drizzle ORM + Zod",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/run-migrate.ts"
  },
  "dependencies": {
    "@atelier/tokens": "*",
    "@hono/node-server": "^1.13.7",
    "@types/pg": "^8.21.0",
    "@vercel/blob": "^2.7.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.16",
    "pg": "^8.23.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
